# All prefixed SWF_REMOTE_ to avoid env var collisions.
SWF_REMOTE_SECRET_KEY=change-me
SWF_REMOTE_DEBUG=True
SWF_REMOTE_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
SWF_REMOTE_DB_NAME=swf_remote
SWF_REMOTE_DB_USER=swf_remote
SWF_REMOTE_DB_PASSWORD=
SWF_REMOTE_DB_HOST=localhost
SWF_REMOTE_DB_PORT=5432

# Static files
SWF_REMOTE_STATIC_URL=/static/

# swf-monitor connection (via SSH tunnel to pandaserver02)
SWF_REMOTE_MONITOR_URL=https://localhost:18443/swf-monitor

# GitHub sign-in. From a GitHub OAuth App whose authorization callback is
# <site>/accounts/github/login/callback/ — on production that is
# https://epic-devcloud.org/prod/accounts/github/login/callback/, including
# the /prod subpath. Left empty, the button renders but the flow fails.
SWF_REMOTE_GITHUB_CLIENT_ID=
SWF_REMOTE_GITHUB_SECRET=
